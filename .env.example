# Copiá este archivo como .env y poné tu clave real.
# .env esta en .gitignore: no se sube al repositorio.
#
# Se usa solo para leer matricula y tipo de avion con un modelo de vision
# (ver vlm_ocr.py). El resto del sistema -deteccion, tracking y conteo-
# funciona sin esto y sin internet.
#
# Conseguila en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ---------------------------------------------------------------------------
# ADSB_SURFACE_REF no es un secreto y NO va en .env: se pone como variable de
# entorno del sistema. Se documenta aca solo para que no se busque en vano.
#
# Es donde esta la antena, y hace falta para decodificar la posicion de los
# aviones EN PISTA (el CPR de superficie necesita un punto cercano para
# resolver la zona). Formato 'lat,lon' o un codigo ICAO de aeropuerto.
# Por defecto: San Isidro (-34.4708,-58.5128), que con +-83 km de tolerancia
# cubre San Fernando, Aeroparque y Ezeiza a la vez. Ver receiver.py.
#
#   set ADSB_SURFACE_REF=-34.4708,-58.5128
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ADSB_RECEIVER tampoco es un secreto: es DONDE esta la antena, y de ahi sale
# todo lo que el sistema mide -distancias, anillos del mapa, alcance
# informado-, asi que si se mueve la antena y no se cambia esto, cada numero
# sigue comparando contra un lugar que ya no existe.
#
# Acepta una clave conocida, un par 'lat,lon', o un codigo ICAO en mayusculas:
#
#   set ADSB_RECEIVER=san-isidro     (por defecto) antena a 10 m
#   set ADSB_RECEIVER=aeroparque     1153 m del umbral 13, antena a 3 m
#   set ADSB_RECEIVER=ypf            Torre YPF, Puerto Madero, antena a 160 m
#   set ADSB_RECEIVER=-34.6054,-58.3625
#   set ADSB_RECEIVER=SABE
#
# La ALTURA sale del preset y manda mas que la cercania para ver aviones EN
# PISTA: el horizonte a un blanco en el suelo es 13.0 km con la antena a 10 m
# y 52.2 km a 160 m. Desde San Isidro la pista de Aeroparque queda a 13.3 km,
# 300 metros MAS LEJOS que el horizonte, y por eso nunca se decodifico una
# posicion en tierra. Desde la torre de YPF entran las tres pistas.
# ADSB_ANTENNA_M pisa la altura del preset si se mide con cinta.
# Ver receiver.py y el circulo verde punteado en /adsb/mapa.
#
# 'aeroparque' es el unico preset donde la altura casi no importa, y conviene
# entender por que antes de copiarlo a otro lado. Esta a 1153 m del umbral 13:
# con la antena a 1 m el horizonte al suelo ya son 4.1 km, 3.6 veces lo que
# hace falta, asi que errarle a la altura no cambia la conclusion. Lo que
# cambia de verdad es el ANGULO: un avion a 1000 ft sobre la pista se ve a
# 1.42 grados desde San Isidro y a 14.84 desde aca. Esa es la razon real por la
# que San Isidro no pasaba de 2134 ft -no el horizonte, que daba de sobra, sino
# los edificios-, y es lo que este punto arregla.
#
# Lo que NO arregla, y conviene saberlo antes de armar: un avion EN la pista se
# ve a 0.24 grados, y un edificio de 30 m a 1 km tapa hasta 1.72. Las posiciones
# en tierra siguen necesitando linea de vista limpia. La pista queda en el
# sector 104-117 grados (ESE); es hacia ahi donde hay que despejar.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ADSB_AIRPORT: contar las operaciones de UN aeropuerto y no de todo lo que
# pasa por la antena. La antena escucha cualquier cosa que vuele cerca, y la
# mayoria no aterriza ni despega de ningun lado, asi que sin esto el conteo de
# aeronaves no dice nada sobre un aeropuerto en particular.
#
#   set ADSB_AIRPORT=SABE        (por defecto) Aeroparque
#   set ADSB_AIRPORT=SADF        San Fernando
#   set ADSB_AIRPORT=NINGUNO     apaga el apartado
#
#   set ADSB_AIRPORT_RADIUS_KM=8      radio del cilindro de operaciones
#   set ADSB_AIRPORT_CEILING_FT=4000  techo del cilindro
#
# Se atribuye por geometria de la trayectoria y no esperando ver el toque en
# pista: se mira que hizo la aeronave dentro del cilindro, bajando o subiendo.
# El apartado informa SIEMPRE la altitud minima que se vio adentro, porque es
# el numero que dice si eso son operaciones o sobrevuelos. Ver aeropuerto.py.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ADSB_GAIN: ganancia del receptor en dB, o "auto". Solo aplica a la fuente de
# IQ crudo.
#
#   set ADSB_GAIN=49.6    (por defecto) el maximo del R820T. Correcto LEJOS.
#   set ADSB_GAIN=auto    lo decide el dongle. Buen punto de partida de cerca.
#   set ADSB_GAIN=30      medido desde San Isidro (13 km): mediana -33.5 dBFS y
#                         una sola aeronave en 70 s, contra 6-8 con 49.6. Muy
#                         baja para esa distancia; razonable pegado a la pista.
#
# La regla no es "mas ganancia es mejor". Lejos cada dB alcanza un avion mas
# lejano; pegado a una pista el receptor SATURA y se pierden mensajes, que se
# siente como recibir menos justo cuando deberia recibir mejor. A 300 m un
# avion llega unos 33 dB mas fuerte que a 13 km, asi que ahi hay que bajar.
#
# No hay que adivinarlo: la pagina /adsb muestra la mediana, el maximo y el
# porcentaje de mensajes contra el techo, y avisa cuando conviene bajar.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ADSB_DB: donde vive la base de mensajes. Por defecto adsb_log.db al lado del
# codigo.
#
#   set ADSB_DB=C:\ruta\a\una\copia\adsb_log.db
#
# Existe por una razon concreta y no por completitud: sin esto, la unica forma
# de comprobar de punta a punta que al mapa le entran filas nuevas era ESCRIBIR
# en el adsb_log.db real -- 11 823 filas que no se pueden volver a capturar --
# o duplicar el arbol entero. Un sistema que no se puede ejercitar sin tocar el
# dato del usuario es un problema en si mismo.
#
# La leen adsb_record.py (que es donde esta LA definicion) y webapp/main.py,
# que la importa de ahi. El grabador ESCRIBE en la ruta que diga esta variable:
# apuntarla a una copia y despues arrancar la grabacion graba en la copia.
# ---------------------------------------------------------------------------
