# --- Secretos: NUNCA subir ---
.env
*.key

# --- Entorno virtual (se recrea con requirements.txt) ---
.venv/
__pycache__/
*.pyc

# --- Videos y material de terceros ---
# Los videos son contenido de YouTube (con derechos de sus autores) y pesan GB.
data/
*.mp4
*.mkv
*.avi
# PDFs de especificaciones descargados de un sitio de terceros: no se
# redistribuyen. Los datos numericos que se extraen de ellos si estan, en
# aircraft_specs.json.
DATOS AVIONES/

# --- Artefactos generados (se regeneran corriendo el pipeline) ---
output/
dataset/
runs/
runway_events.db
kernel.errors.txt

# --- Pesos de modelos ---
# yolov8n.pt lo descarga Ultralytics solo en el primer uso.
# El modelo OpenVINO se genera con export_openvino.py.
*.pt
*.onnx
yolov8n_openvino_model/

# --- Binarios locales ---
tools/

# Journal transitorio de SQLite: aparece mientras se graba, no es del proyecto.
*.db-journal

# plotly.min.js se baja con webapp/bajar_plotly.py, no viaja en el repo.
webapp/static/plotly.min.js

# La base en WAL escribe dos archivos mas al lado del .db. Como adsb_log.db
# esta trackeada, sin estos ignores un "git add ." durante una grabacion
# subiria el -wal y el -shm, que no son datos sino estado transitorio del
# journal -- y ademas confunden: el .db versionado se queda ATRAS del -wal
# hasta el checkpoint.
*.db-wal
*.db-shm

# Tabla del Doc 8643: se importa con tipos_avion.py, no viaja en el repo.
tools/aircraft_types.sqlite
